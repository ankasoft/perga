# Maintainer: ankasoft <noreply@ankasoft.example>
# shellcheck disable=SC2034,SC2154,SC2148

pkgname=perga-bin
_pkgname=perga
pkgver=0.1.1
pkgrel=1
pkgdesc="A terminal Markdown browser with a persistent file tree, tabs, wiki-links and backlinks"
arch=('x86_64' 'aarch64')
url="https://github.com/ankasoft/perga"
license=('MIT' 'Apache-2.0')
provides=('perga')
conflicts=('perga')
options=('!debug' '!strip')

_url_base="$url/releases/download/v$pkgver"
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.xz::$_url_base/$_pkgname-x86_64-unknown-linux-musl.tar.xz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.xz::$_url_base/$_pkgname-aarch64-unknown-linux-musl.tar.xz")

# Replace both per release; see packaging/README.md.
sha256sums_x86_64=('77e3f7ba26c2d9c0f08001b6b0963d8f9fa771434d3712223fa2e203ca212bc9')
sha256sums_aarch64=('08f01a728e8b8b636cb97758e838f462224d44781b586b3fcd51f692f336859a')

package() {
  # dist's archives hold one top-level directory named after the target.
  cd "$srcdir/$_pkgname-$CARCH-unknown-linux-musl"

  install -Dm755 perga "$pkgdir/usr/bin/perga"

  # The man page and the completions are generated by the release pipeline and
  # shipped in the tarball, so this installs them rather than running the
  # binary — a cross-built aarch64 package is assembled on x86_64.
  install -Dm644 perga.1 "$pkgdir/usr/share/man/man1/perga.1"
  install -Dm644 completions/perga.bash \
    "$pkgdir/usr/share/bash-completion/completions/perga"
  install -Dm644 completions/perga.zsh \
    "$pkgdir/usr/share/zsh/site-functions/_perga"
  install -Dm644 completions/perga.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/perga.fish"

  # Both licence files: perga is `MIT OR Apache-2.0` and the user picks.
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
